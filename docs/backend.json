
{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile with wallet and admin status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "reference_code": { "type": "string" },
        "wallet_balance": { "type": "number" },
        "is_admin": { "type": "boolean" },
        "role": { "type": "string", "enum": ["api_user", "falaa", "base"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Consolidated order record for Dakazina",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "format": "uuid" },
        "store_id": { "type": "string", "format": "uuid" },
        "package_id": { "type": "integer" },
        "network_id": { "type": "integer" },
        "phone_number": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "delivered", "failed"] },
        "actual_cost": { "type": "number" },
        "reseller_profit": { "type": "number" },
        "dakazina_order_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SKPlugOrder": {
      "title": "SK Plug Order",
      "description": "Orders placed through the SK Plug provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "recipient": { "type": "string" },
        "network": { "type": "string" },
        "gb_size": { "type": "string" },
        "sell_price_ghs": { "type": "number" },
        "order_id": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "delivered", "failed"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Global settings for the application",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "object" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {}
}
